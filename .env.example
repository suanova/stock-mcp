# ===== stock-mcp configuration =====
# This file is loaded automatically when you run `python -m stock_mcp` or
# `dsa-mcp-server` from the same directory. You can also export these environment
# variables before running. All values are optional; defaults are shown.

# DSA FastAPI base URL. The server must be running and reachable
# (e.g. `python main.py --serve-only` inside the daily_stock_analysis repo).
# DSA_API_BASE_URL=http://127.0.0.1:8000

# MCP Streamable HTTP bind address and port. Keep 127.0.0.1 unless you
# explicitly need remote access (and then put it behind auth/a firewall).
# DSA_MCP_HOST=127.0.0.1
# DSA_MCP_PORT=8765

# The MCP endpoint path. Clients connect to http://<host>:<port><path>.
# DSA_MCP_PATH=/mcp

# --- DSA admin auth (only needed when DSA has ADMIN_AUTH_ENABLED=true) ---
# When DSA_API_AUTH_ENABLED=true, stock-mcp logs in once via
# POST /api/v1/auth/login and reuses the session cookie. When false (default,
# matching DSA's default-open mode), no auth is sent.
# DSA_API_AUTH_ENABLED=false
# DSA_API_PASSWORD=

# --- HTTP timeouts (seconds) ---
# DSA_API_TIMEOUT is used for short calls (skills, login, status).
# DSA_API_REQUEST_TIMEOUT is used for ask_stock, which runs a multi-step
# agent and can take minutes. Raise it if your LLM/backend is slow.
# DSA_API_TIMEOUT=30
# DSA_API_REQUEST_TIMEOUT=600

# Log level for stock-mcp's own stderr logging.
# DSA_MCP_LOG_LEVEL=INFO

# --- file logging ---
# If set, also write logs to this file path. Parent directories are created automatically.
# DSA_MCP_LOG_FILE=/var/log/stock-mcp/server.log
#
# Rotate the log file when it reaches this size in bytes. Set to 0 to disable rotation.
# DSA_MCP_LOG_MAX_BYTES=10485760
#
# Number of rotated log files to keep.
# DSA_MCP_LOG_BACKUP_COUNT=3
